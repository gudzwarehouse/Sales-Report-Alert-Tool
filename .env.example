# Copy to .env and fill in. Real values currently live only in .env (gitignored).

# Run-notification email (Gmail SMTP + app password), same pattern as the other
# "Final Automations" projects.
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_APP_PASSWORD=

# Default alert recipients for pipeline-error emails.
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_CC=

# StockFeeds.xlsm on the management server -- the pipeline's SKU lookup
# always fetches fresh from here, never a local cached copy. Use the UNC
# path (\\server\share\...), not a mapped drive letter -- a drive letter is
# per-session and may not exist under whatever account runs the scheduled task.
STOCKFEEDS_XLSM_PATH=
STOCKFEEDS_XLSM_PASSWORD=

# Windows username the VBA skips timers for (dev/test machine gate).
TEST_USERNAME=

# LEGACY -- no longer read by run_sales_alerts.py (Phase 3 switched to
# ca_orders_client.py querying ChannelAdvisor's Orders API directly). Kept
# for rollback reference only.
LAST_HOUR_FOLDER=
LAST_4_HOURS_FOLDER=

# Recipient for the once-daily (3pm) summary email from run_daily_summary.py.
# Falls back to NOTIFY_EMAIL_FROM if unset.
DAILY_SUMMARY_EMAIL=
# CC'd on the daily summary (comma-separated). Falls back to
# theekshana@gudz.com, aflal@gudz.com (run_daily_summary.py's DEFAULT_CC) if unset.
DAILY_SUMMARY_CC=

# ChannelAdvisor ("CA") OAuth credentials + API endpoints, same accounts used
# by Amazon Padding Automation. Not currently called by anything in this
# project (kept for reference / future use).
CA_API_URL=
CA_ORDERS_API_URL=
CA_PRODUCTS_API_URL=
CA_TOKEN_URL=

CA_UK_APPLICATION_ID=
CA_UK_SHARED_SECRET=
CA_UK_REFRESH_TOKEN=
CA_UK_PROFILE_ID=

CA_IRE_APPLICATION_ID=
CA_IRE_SHARED_SECRET=
CA_IRE_REFRESH_TOKEN=
CA_IRE_PROFILE_ID=
